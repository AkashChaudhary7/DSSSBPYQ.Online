# Global security headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: no-referrer-when-downgrade

# Plain-text files for AdMob / AdSense verification and search crawlers
/app-ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# Long-term caching for compiled JS and CSS bundles
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Optimal caching for the JSON mock files and metadata
/content/*
  Cache-Control: public, max-age=172800, stale-while-revalidate=3600

# Cache-Control for images and assets under folders
/Computer/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
