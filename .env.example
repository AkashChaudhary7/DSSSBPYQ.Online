# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# GOOGLE ADMOB CONFIGURATION (TEST vs PRODUCTION)
# ============================================================================
# Set VITE_ADMOB_IS_PROD="true" to enable production AdMob IDs.
# Leave empty or set to "false" to use Google official test ad unit IDs.
VITE_ADMOB_IS_PROD="false"

# Production AdMob Application ID (e.g. ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX)
VITE_ADMOB_APP_ID="ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX"

# Production Rewarded Video Ad Unit ID (e.g. ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX)
VITE_ADMOB_REWARDED_ID="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"

# Production Interstitial Ad Unit ID (e.g. ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX)
VITE_ADMOB_INTERSTITIAL_ID="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"

# Post-quiz Interstitial Display Frequency (Default: 1 = every quiz submission)
VITE_ADMOB_INTERSTITIAL_FREQUENCY="1"
