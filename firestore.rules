rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure path for analytics
    match /analytics/global {
      allow read, write: if true;
    }

    // Secure path for custom uploaded quizzes
    match /custom_quizzes/{quizId} {
      allow read, write: if true;
    }

    // Path for payment UTRs (provisional access & admin verification)
    match /payment_utrs/{utrId} {
      allow read, write: if true;
    }

    // Path for referral payout requests
    match /payout_requests/{requestId} {
      allow read, write: if true;
    }

    // Path for admin-generated activation & restore codes
    match /admin_activation_codes/{codeId} {
      allow read, write: if true;
    }
  }
}
